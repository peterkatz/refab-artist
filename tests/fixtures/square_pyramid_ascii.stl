solid square_pyramid
  facet normal 0 0 -1
    outer loop
      vertex -30 -30 0
      vertex 30 30 0
      vertex 30 -30 0
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex -30 -30 0
      vertex -30 30 0
      vertex 30 30 0
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex -30 -30 0
      vertex 30 -30 0
      vertex 0 0 55
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 30 -30 0
      vertex 30 30 0
      vertex 0 0 55
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 30 30 0
      vertex -30 30 0
      vertex 0 0 55
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex -30 30 0
      vertex -30 -30 0
      vertex 0 0 55
    endloop
  endfacet
endsolid square_pyramid
